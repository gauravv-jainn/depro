# --- Warehouse. Leave everything empty to use the local DuckDB file. ---
# BigQuery (set GCP_PROJECT to switch the whole pipeline + BI app to BigQuery)
GCP_PROJECT=
BQ_LOCATION=US
# Path to a service-account JSON key. Leave empty to use `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
# Docker only: path of that key inside the Airflow container (put the file in orchestration/secrets/)
AIRFLOW_GCP_KEY=

# dbt/warehouse target: duckdb or bigquery. Auto-detected from GCP_PROJECT if empty.
DBT_TARGET=

# --- Airbyte (optional). If AIRBYTE_CONNECTION_ID is set, Airflow triggers a real Airbyte sync;
#     otherwise the local CSV loader is used. ---
AIRBYTE_URL=http://localhost:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
# several connections: comma separated
AIRBYTE_CONNECTION_ID=

# --- Conversational BI LLM (optional). Without a key, the rule-based parser is used. ---
ANTHROPIC_API_KEY=
